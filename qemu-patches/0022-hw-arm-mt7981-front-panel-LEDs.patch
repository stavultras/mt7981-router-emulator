diff --git a/hw/arm/mt7981/ws2812b.c b/hw/arm/mt7981/ws2812b.c
new file mode 100644
index 0000000..312f1e7
--- /dev/null
+++ b/hw/arm/mt7981/ws2812b.c
@@ -0,0 +1,150 @@
+/*
+ * WS2812B RGB LED chain on a SPI bus, as driven by OpenWrt's
+ * leds-ws2812b (e.g. the Xiaomi Redmi AX6000 front LEDs): every data bit
+ * is a 3-bit SPI pattern 1x0 (x = the bit), a transfer starts with zero
+ * bytes (the "reset" pulse) followed by 3 bytes of pattern per colour
+ * byte, 3 colour bytes per LED.  Only the decoded colours are kept, for
+ * the LED panel.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "hw/ssi/ssi.h"
+#include "mt7981.h"
+
+#define WS_MAX_LEDS     16
+
+OBJECT_DECLARE_SIMPLE_TYPE(Ws2812bState, WS2812B_SPI)
+
+struct Ws2812bState {
+    SSIPeripheral parent_obj;
+    uint8_t part[3];            /* SPI bytes of the colour byte being sent */
+    int npart;
+    int n;                      /* colour bytes since the reset pulse */
+    uint8_t rgb[WS_MAX_LEDS][3];
+    uint8_t lit[WS_MAX_LEDS][3];    /* last colour that was not black */
+    uint32_t changes[WS_MAX_LEDS];  /* on <-> off (LED panel: blinking) */
+    bool seen[WS_MAX_LEDS];
+};
+
+/*
+ * LED idx: its three colour bytes in the order sent (false: never set),
+ * the last colour other than black and the count of on/off changes
+ */
+bool ws2812b_get(DeviceState *dev, int idx, uint8_t rgb[3], uint8_t lit[3],
+                 uint32_t *changes)
+{
+    Ws2812bState *s = WS2812B_SPI(dev);
+
+    if (idx < 0 || idx >= WS_MAX_LEDS) {
+        return false;
+    }
+    memcpy(rgb, s->rgb[idx], 3);
+    memcpy(lit, s->lit[idx], 3);
+    *changes = s->changes[idx];
+    return s->seen[idx];
+}
+
+static void ws2812b_set(Ws2812bState *s, int n, uint8_t v)
+{
+    uint8_t *c = s->rgb[n / 3];
+    bool was_on = c[0] | c[1] | c[2];
+
+    c[n % 3] = v;
+    s->seen[n / 3] = true;
+    /* the LED's last byte completes its colour */
+    if (n % 3 == 2) {
+        bool on = c[0] | c[1] | c[2];
+        if (on) {
+            memcpy(s->lit[n / 3], c, 3);
+        }
+        if (on != was_on) {
+            s->changes[n / 3]++;
+        }
+    }
+}
+
+/*
+ * Encoded data never contains a zero byte (every bit starts with a 1), so
+ * a zero byte is the reset pulse: the next colour byte is LED 0's first.
+ * Linux's spi-mt65xx keeps CS asserted between transfers (pause mode), so
+ * CS does not mark the frames.
+ */
+static uint32_t ws2812b_transfer(SSIPeripheral *dev, uint32_t val)
+{
+    Ws2812bState *s = WS2812B_SPI(dev);
+    uint32_t bits;
+    uint8_t v = 0;
+
+    if ((val & 0xff) == 0) {
+        s->npart = 0;
+        s->n = 0;
+        return 0;
+    }
+    s->part[s->npart++] = val;
+    if (s->npart < 3) {
+        return 0;
+    }
+    s->npart = 0;
+    bits = s->part[0] << 16 | s->part[1] << 8 | s->part[2];
+    for (int b = 0; b < 8; b++) {
+        v = v << 1 | ((bits >> (22 - 3 * b)) & 1);
+    }
+    if (s->n < WS_MAX_LEDS * 3) {
+        ws2812b_set(s, s->n++, v);
+    }
+    return 0;
+}
+
+static int ws2812b_set_cs(SSIPeripheral *dev, bool select)
+{
+    Ws2812bState *s = WS2812B_SPI(dev);
+
+    s->npart = 0;
+    s->n = 0;
+    return 0;
+}
+
+static void ws2812b_realize(SSIPeripheral *dev, Error **errp)
+{
+}
+
+static void ws2812b_reset(DeviceState *dev)
+{
+    Ws2812bState *s = WS2812B_SPI(dev);
+
+    s->npart = s->n = 0;
+    memset(s->rgb, 0, sizeof(s->rgb));
+    memset(s->lit, 0, sizeof(s->lit));
+    memset(s->changes, 0, sizeof(s->changes));
+    memset(s->seen, 0, sizeof(s->seen));
+}
+
+static void ws2812b_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+
+    k->realize = ws2812b_realize;
+    k->transfer = ws2812b_transfer;
+    k->set_cs = ws2812b_set_cs;
+    k->cs_polarity = SSI_CS_LOW;
+    device_class_set_legacy_reset(dc, ws2812b_reset);
+    dc->desc = "WS2812B RGB LED chain (SPI)";
+}
+
+static const TypeInfo ws2812b_info = {
+    .name = TYPE_WS2812B_SPI,
+    .parent = TYPE_SSI_PERIPHERAL,
+    .instance_size = sizeof(Ws2812bState),
+    .class_init = ws2812b_class_init,
+};
+
+static void ws2812b_register_types(void)
+{
+    type_register_static(&ws2812b_info);
+}
+
+type_init(ws2812b_register_types)

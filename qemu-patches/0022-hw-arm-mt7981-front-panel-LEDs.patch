diff --git a/hw/arm/mt7981/mt7981_eth.c b/hw/arm/mt7981/mt7981_eth.c
index 6176514..d5f1d86 100644
--- a/hw/arm/mt7981/mt7981_eth.c
+++ b/hw/arm/mt7981/mt7981_eth.c
@@ -188,6 +188,7 @@ struct MT7981EthState {
     uint32_t p5phy_addr;
 
     EthPort ports[8];
+    uint32_t frames[8];         /* frames through each port (LED activity) */
     uint8_t *txbuf;
     int tx_mask;        /* special tag port mask of the frame being sent */
 };
@@ -801,6 +802,69 @@ static EthPhy *mdio_find_phy(MT7981EthState *s, int addr, bool sw_internal)
     return NULL;
 }
 
+/*
+ * LED pin idx of the external PHY at MDIO address addr, as its LED
+ * registers program it: -1 = no such PHY (or LED), else bit 0 = lit,
+ * bit 1 = blinks with traffic.  *frames counts the frames of its port.
+ */
+int mt7981_eth_phy_led(DeviceState *dev, int addr, int idx, uint32_t *frames)
+{
+    MT7981EthState *s = MT7981_ETH(dev);
+    EthPhy *p = NULL;
+    int port = -1;
+    uint32_t ctl, act;
+    bool on;
+
+    for (int g = 0; g < 2; g++) {
+        if (s->dphy_type[g] && addr == s->dphy_addr[g]) {
+            p = &s->dphy[g];
+            port = 5 + g;
+        }
+    }
+    if (!p && s->p5phy_type && addr == s->p5phy_addr) {
+        p = &s->p5phy;
+        port = 7;
+    }
+    if (!p || idx < 0 || idx > 3) {
+        return -1;
+    }
+    *frames = s->frames[port];
+    if (p->in_reset) {
+        return 0;
+    }
+    switch (p->type) {
+    case PHY_RTL8221B:
+        /*
+         * VEND2 0xd032 + 2n: link speeds that light LED n (bit 5 = 2.5G,
+         * the link here), 0xd040 bit n: blink on traffic, 0xd044 bit n:
+         * inverted (the driver's "always on": no speeds + inverted)
+         */
+        ctl = ht_get(p->mmd, (31 << 16) | (0xd032 + 2 * idx), 0);
+        act = ht_get(p->mmd, (31 << 16) | 0xd040, 0) & BIT(idx);
+        on = p->link && (ctl & BIT(5));
+        if (ht_get(p->mmd, (31 << 16) | 0xd044, 0) & BIT(idx)) {
+            on = !on;
+        }
+        return on | ((on && act) ? 2 : 0);
+    case PHY_GPY211:
+        /*
+         * PHY_LED (0x1b): bit 8+n hardware control, else bit n = on;
+         * VSPEC1_LED(n) (VEND1 1+n): [7:4] link speeds (bit 3 = 2.5G),
+         * [11:8] pulse on TX/RX
+         */
+        ctl = p->c22[0x1b];
+        if (!(ctl & BIT(8 + idx))) {
+            return !!(ctl & BIT(idx));
+        }
+        ctl = ht_get(p->mmd, (30 << 16) | (1 + idx), 0);
+        on = p->link && (ctl & BIT(4 + 3));
+        return on | ((on && (ctl & (3 << 8))) ? 2 : 0);
+    default:
+        /* no LED registers modelled: lit while the link is up */
+        return p->link | (p->link ? 2 : 0);
+    }
+}

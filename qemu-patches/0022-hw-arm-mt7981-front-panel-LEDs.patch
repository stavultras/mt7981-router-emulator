     if (gdm == 0 && s->has_switch) {
         sw_cpu_deliver(s, s->tx_mask, f, len);
     } else if (s->dphy_type[gdm] && s->dphy[gdm].link && s->ports[5 + gdm].nic) {
+        s->frames[5 + gdm]++;
         qemu_send_packet(qemu_get_queue(s->ports[5 + gdm].nic), f, len);
     }
 }
@@ -1671,6 +1738,7 @@ static ssize_t port_receive(NetClientState *nc, const uint8_t *buf,
         buf = pad;
         size = 60;
     }
+    s->frames[p->index]++;
     if (p->index == 7) {
         if (s->p5phy.link) {
             sw_forward(s, 5, buf, size);
diff --git a/hw/arm/mt7981/mt7981_leds.c b/hw/arm/mt7981/mt7981_leds.c
new file mode 100644
index 0000000..531f0d1
--- /dev/null
+++ b/hw/arm/mt7981/mt7981_leds.c
@@ -0,0 +1,290 @@
+/*
+ * Front panel LEDs of the emulated board (machine options led1..ledN):
+ *
+ *   ledN=<name>: <colour> <source> [+ <colour> <source>...]
+ *
+ * sources  gpio:N[:low]   SoC GPIO, lit while driven high (low: low)
+ *          phy:ADDR:N     LED pin N of the Ethernet PHY at MDIO address
+ *                         ADDR, as its LED registers program it
+ *          ws2812:BUS:N   LED N of a WS2812B chain on SPI bus BUS
+ *          pwm:N          PWM channel N (lit while enabled with a duty)
+ *
+ * Several colours of one lamp (bi-colour status LEDs) are joined with "+".
+ * Every 50 ms the sources are sampled; the machine property "led-state"
+ * (qom-get /machine led-state) returns one entry per LED, ';' separated,
+ * of one value per colour, ',' separated: 0 off, 1 on, b blinking, or
+ * for a WS2812B #rrggbb, b#rrggbb blinking in that colour.  With
+ * gpio-log=on the changes are printed.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/cutils.h"
+#include "qemu/timer.h"
+#include "qemu/error-report.h"
+#include "qapi/error.h"
+#include "hw/qdev-core.h"
+#include "hw/ssi/ssi.h"
+#include "mt7981.h"
+#include "mt7981_leds.h"
+
+#define TICK_MS     50
+#define WINDOW      4           /* ticks: 200 ms decide "blinking" */
+
+enum { SRC_GPIO, SRC_PHY, SRC_WS2812, SRC_PWM };
+
+typedef struct LedChan {
+    char *color;
+    int src;
+    int a, b;                   /* pin / MDIO address / bus / channel; LED */
+    bool low;
+    uint32_t last;              /* toggles / frames at the previous tick */
+    uint8_t hist[WINDOW];       /* changes per tick */
+    char state[12];
+} LedChan;
+
+typedef struct Led {
+    char *name;
+    LedChan ch[4];
+    int nch;
+    char *logged;
+} Led;
+
+struct RouterLeds {
+    RouterLedsHw hw;
+    Led *led;
+    int n;
+    int tick;
+    bool log;
+    DeviceState *ws[3];
+    QEMUTimer *timer;
+};
+
+static bool parse_chan(LedChan *c, const char *text, int nspi, Error **errp)
+{
+    g_auto(GStrv) w = g_strsplit_set(g_strstrip(g_strdup(text)), " \t", -1);
+    g_auto(GStrv) f = NULL;
+    int nw = 0, nf;
+    char *words[2];
+
+    for (int i = 0; w[i]; i++) {
+        if (*w[i]) {
+            if (nw == 2) {
+                goto bad;
+            }
+            words[nw++] = w[i];
+        }
+    }
+    if (nw != 2) {
+        goto bad;
+    }
+    c->color = g_strdup(words[0]);
+    f = g_strsplit(words[1], ":", -1);
+    nf = g_strv_length(f);
+    if (!strcmp(f[0], "gpio") &&
+        (nf == 2 || (nf == 3 && !strcmp(f[2], "low")))) {
+        c->src = SRC_GPIO;
+        c->a = atoi(f[1]);
+        c->low = nf == 3;
+    } else if (!strcmp(f[0], "phy") && nf == 3) {
+        c->src = SRC_PHY;
+        c->a = atoi(f[1]);
+        c->b = atoi(f[2]);
+    } else if (!strcmp(f[0], "ws2812") && nf == 3) {
+        c->src = SRC_WS2812;
+        c->a = atoi(f[1]);
+        c->b = atoi(f[2]);
+        if (c->a < 0 || c->a >= nspi) {
+            error_setg(errp, "SPI%d does not exist (SPI0..SPI%d)", c->a,
+                       nspi - 1);
+            return false;
+        }
+    } else if (!strcmp(f[0], "pwm") && nf == 2) {
+        c->src = SRC_PWM;
+        c->a = atoi(f[1]);
+    } else {
+        goto bad;
+    }
+    return true;
+bad:
+    error_setg(errp, "\"%s\": expected <colour> gpio:N[:low] | phy:ADDR:N | "
+               "ws2812:BUS:N | pwm:N", text);
+    return false;
+}
+
+static bool parse_led(Led *l, const char *def, int nspi, Error **errp)
+{
+    const char *colon = strstr(def, ": ");
+    g_auto(GStrv) parts = NULL;
+
+    if (!colon) {
+        error_setg(errp, "\"%s\": expected <name>: <colour> <source>", def);
+        return false;
+    }
+    l->name = g_strstrip(g_strndup(def, colon - def));
+    parts = g_strsplit(colon + 2, "+", -1);
+    for (int i = 0; parts[i]; i++) {
+        if (l->nch == ARRAY_SIZE(l->ch)) {
+            error_setg(errp, "\"%s\": at most %d colours", def,
+                       (int)ARRAY_SIZE(l->ch));
+            return false;
+        }
+        if (!parse_chan(&l->ch[l->nch++], parts[i], nspi, errp)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+/* record this tick's change count, return the changes of the window */
+static int window(RouterLeds *r, LedChan *c, uint32_t count)
+{
+    int sum = 0;
+
+    c->hist[r->tick % WINDOW] = MIN(count - c->last, 255);
+    c->last = count;
+    for (int i = 0; i < WINDOW; i++) {
+        sum += c->hist[i];
+    }
+    return sum;
+}
+
+static void sample(RouterLeds *r, LedChan *c)
+{
+    uint32_t count = 0;
+    int v;
+    uint8_t rgb[3], lit[3];
+
+    switch (c->src) {
+    case SRC_GPIO:
+        v = mt7981_pinctrl_out(r->hw.pinctrl, c->a, &count);
+        /* several level changes within 200 ms: a blinking trigger */
+        if (window(r, c, count) >= 3 && v >= 0) {
+            pstrcpy(c->state, sizeof(c->state), "b");
+        } else {
+            pstrcpy(c->state, sizeof(c->state),
+                    v < 0 ? "0" : (v ^ c->low) ? "1" : "0");
+        }
+        break;
+    case SRC_PHY:
+        v = r->hw.eth ? mt7981_eth_phy_led(r->hw.eth, c->a, c->b, &count) : -1;
+        if (v < 0) {
+            pstrcpy(c->state, sizeof(c->state), "0");
+            break;
+        }
+        /* traffic on a LED set to blink with it */
+        if (window(r, c, count) && (v & 2)) {
+            pstrcpy(c->state, sizeof(c->state), "b");
+        } else {
+            pstrcpy(c->state, sizeof(c->state), (v & 1) ? "1" : "0");
+        }
+        break;
+    case SRC_WS2812:
+        if (!r->ws[c->a] || !ws2812b_get(r->ws[c->a], c->b, rgb, lit, &count)) {
+            memset(rgb, 0, sizeof(rgb));
+        }
+        /* blinking: "b" and the colour it blinks in */
+        if (window(r, c, count) >= 3) {
+            snprintf(c->state, sizeof(c->state), "b#%02x%02x%02x",
+                     lit[0], lit[1], lit[2]);
+        } else {
+            snprintf(c->state, sizeof(c->state), "#%02x%02x%02x",
+                     rgb[0], rgb[1], rgb[2]);
+        }
+        break;
+    case SRC_PWM: {
+        /* enable bits at the base, PWMTHRES (duty) in the channel block */
+        hwaddr ch = r->hw.pwm_base + r->hw.pwm_chan_base +
+                    c->a * r->hw.pwm_chan_width;
+        bool on = (mt7981_sysctl_peek(r->hw.sysctl, r->hw.pwm_base) &
+                   BIT(c->a)) &&
+                  (mt7981_sysctl_peek(r->hw.sysctl, ch + 0x30) & 0x1fff);
+        pstrcpy(c->state, sizeof(c->state), on ? "1" : "0");
+        break;
+    }
+    }
+}
+
+static void leds_tick(void *opaque)
+{
+    RouterLeds *r = opaque;
+
+    r->tick++;
+    for (int i = 0; i < r->n; i++) {
+        Led *l = &r->led[i];
+        for (int k = 0; k < l->nch; k++) {
+            sample(r, &l->ch[k]);
+        }
+        if (r->log) {
+            GString *g = g_string_new(NULL);
+            for (int k = 0; k < l->nch; k++) {
+                const char *st = l->ch[k].state;
+                g_string_append_printf(g, "%s%s %s", k ? ", " : "",
+                    l->ch[k].color,
+                    !strcmp(st, "1") ? "on" : !strcmp(st, "0") ? "off" :
+                    !strcmp(st, "b") ? "blinking" : st);
+            }
+            if (!l->logged || strcmp(l->logged, g->str)) {
+                info_report("LED %s: %s", l->name, g->str);
+                g_free(l->logged);
+                l->logged = g_strdup(g->str);
+            }
+            g_string_free(g, true);
+        }
+    }
+    timer_mod(r->timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + TICK_MS);
+}
+
+RouterLeds *router_leds_new(char **defs, int ndefs, const RouterLedsHw *hw,
+                            bool log, Error **errp)
+{
+    RouterLeds *r = g_new0(RouterLeds, 1);
+
+    r->hw = *hw;
+    r->log = log;
+    r->led = g_new0(Led, ndefs);
+    for (int i = 0; i < ndefs; i++) {
+        Error *err = NULL;
+        if (!defs[i] || !*defs[i]) {
+            continue;
+        }
+        if (!parse_led(&r->led[r->n], defs[i], hw->nspi, &err)) {
+            error_propagate_prepend(errp, err, "led%d: ", i + 1);
+            return NULL;
+        }
+        /* a WS2812B chain listens on its SPI bus */
+        for (int k = 0; k < r->led[r->n].nch; k++) {
+            LedChan *c = &r->led[r->n].ch[k];
+            if (c->src == SRC_WS2812 && !r->ws[c->a]) {
+                DeviceState *spi = hw->spi[c->a];
+                r->ws[c->a] = qdev_new(TYPE_WS2812B_SPI);
+                qdev_realize_and_unref(r->ws[c->a],
+                                       qdev_get_child_bus(spi, "spi"),
+                                       &error_fatal);
+                qdev_connect_gpio_out_named(spi, "cs", 0,
+                    qdev_get_gpio_in_named(r->ws[c->a], SSI_GPIO_CS, 0));
+            }
+        }
+        r->n++;
+    }
+    if (r->n) {
+        r->timer = timer_new_ms(QEMU_CLOCK_REALTIME, leds_tick, r);
+        timer_mod(r->timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + TICK_MS);
+    }
+    return r;
+}
+
+char *router_leds_state(RouterLeds *r)
+{
+    GString *g = g_string_new(NULL);
+
+    for (int i = 0; r && i < r->n; i++) {
+        for (int k = 0; k < r->led[i].nch; k++) {
+            g_string_append_printf(g, "%s%s", k ? "," : (i ? ";" : ""),
+                                   r->led[i].ch[k].state[0] ?
+                                   r->led[i].ch[k].state : "0");
+        }
+    }
+    return g_string_free(g, false);
+}
diff --git a/hw/arm/mt7981/mt7981_leds.h b/hw/arm/mt7981/mt7981_leds.h
new file mode 100644
index 0000000..9510982
--- /dev/null
+++ b/hw/arm/mt7981/mt7981_leds.h
@@ -0,0 +1,27 @@
+/*
+ * Front panel LEDs of the emulated board (see mt7981_leds.c)
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_ARM_MT7981_LEDS_H
+#define HW_ARM_MT7981_LEDS_H
+
+#include "hw/qdev-core.h"
+
+typedef struct RouterLedsHw {
+    DeviceState *pinctrl, *eth, *sysctl;
+    DeviceState *spi[3];        /* SPI masters (WS2812B chains) */
+    int nspi;
+    hwaddr pwm_base;            /* PWM controller */
+    hwaddr pwm_chan_base, pwm_chan_width;   /* its channel register blocks */
+} RouterLedsHw;
+
+typedef struct RouterLeds RouterLeds;
+
+RouterLeds *router_leds_new(char **defs, int ndefs, const RouterLedsHw *hw,
+                            bool log, Error **errp);
+/* "1,0;b;#ff0000": per LED, per colour (see mt7981_leds.c) */
+char *router_leds_state(RouterLeds *r);
+
+#endif
diff --git a/hw/arm/mt7981/mt7981_pinctrl.c b/hw/arm/mt7981/mt7981_pinctrl.c
index 47a6b6b..16e8ade 100644
--- a/hw/arm/mt7981/mt7981_pinctrl.c
+++ b/hw/arm/mt7981/mt7981_pinctrl.c
@@ -33,6 +33,7 @@ struct MT7981PinctrlState {
     uint32_t bootstrap;         /* MT7987 boot strap register (gpio + 0x6f0) */
     qemu_irq pin_out[MAX_PINS]; /* pad level as seen by board devices */
     uint8_t pin_out_level[MAX_PINS];
+    uint32_t toggles[MAX_PINS]; /* level changes (LED panel: blinking) */
 
     uint32_t dir[NWORDS], dout[NWORDS], mode[NMODE];
     uint32_t ext_level[NWORDS];     /* level driven by board devices */
@@ -69,11 +70,30 @@ static void pins_update(MT7981PinctrlState *s)
         uint8_t lvl = (s->dir[w] & BIT(b)) ? !!(s->dout[w] & BIT(b)) : 1;
         if (lvl != s->pin_out_level[pin]) {
             s->pin_out_level[pin] = lvl;
+            s->toggles[pin]++;
             qemu_set_irq(s->pin_out[pin], lvl);
         }
     }
 }
 
+/*
+ * An LED on a pin: -1 while the pin is not driven (input, the LED stays
+ * dark), else the output level.  *toggles counts level changes.
+ */
+int mt7981_pinctrl_out(DeviceState *dev, int pin, uint32_t *toggles)
+{
+    MT7981PinctrlState *s = MT7981_PINCTRL(dev);
+
+    if (pin < 0 || pin >= (int)s->npins) {
+        return -1;
+    }
+    *toggles = s->toggles[pin];
+    if (!(s->dir[pin / 32] & BIT(pin % 32))) {
+        return -1;
+    }
+    return !!(s->dout[pin / 32] & BIT(pin % 32));
+}
